<odoo>
    <!-- LEGADO (TG-86): a rubrica própria deste módulo para o reflexo das
         horas extras no DSR foi substituída pela DSR_HE do l10n_br_hr_payroll.
         O registro fica, fora de qualquer estrutura e noupdate, porque holerites
         antigos têm linhas que apontam para ele (apagá-lo quebraria a chave
         estrangeira e o histórico). Não é calculado. -->
    <data noupdate="1">
        <record id="hr_rule_dsr_he" model="hr.salary.rule">
            <field name="name">DSR sobre Horas Extras (legado do ponto)</field>
            <field name="sequence" eval="7" />
            <field name="code">DSR_HE</field>
            <field
                name="category_id"
                ref="l10n_br_hr_payroll.hr_salary_rule_category_alw"
            />
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = 0.0
        </field>
            <field
                name="note"
            >Legado: o reflexo no DSR é a rubrica DSR_HE do l10n_br_hr_payroll. Mantida só para o histórico dos holerites que a usaram.</field>
        </record>
    </data>

    <!-- Intervalo intrajornada suprimido: art. 71, § 4º da CLT, na redação da
         Lei 13.467/2017. Paga-se APENAS o período suprimido, com acréscimo de
         50%, e a verba tem natureza INDENIZATÓRIA - por isso fica fora das
         bases de INSS e IRRF. -->
    <record id="hr_rule_intervalo_suprimido" model="hr.salary.rule">
        <field name="name">Intervalo Intrajornada Suprimido</field>
        <field name="sequence" eval="8" />
        <field name="code">INTERV_SUPRIMIDO</field>
        <field name="category_id" ref="hr_salary_rule_category_ind" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = payslip.l10n_br_intervalo_suprimido &gt; 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
salario_hora = contract.wage / contract._l10n_br_divisor_horas_mensais()
result = tools.br.round_money(
    salario_hora * 1.5 * payslip.l10n_br_intervalo_suprimido
)
        </field>
        <field
            name="note"
        >Art. 71, § 4º da CLT (Lei 13.467/2017): apenas o período suprimido, com 50%, de natureza indenizatória - não integra a base de INSS nem de IRRF.</field>
    </record>
</odoo>
