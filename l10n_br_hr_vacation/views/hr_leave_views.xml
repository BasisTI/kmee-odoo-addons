<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_leave_view_form_vacation" model="ir.ui.view">
        <field name="name">hr.leave.form.vacation</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field
                    name="l10n_br_aviso_dobro"
                    readonly="1"
                    nolabel="1"
                    colspan="2"
                    class="text-warning fw-bold"
                    invisible="not l10n_br_aviso_dobro"
                />
                <field
                    name="l10n_br_aviso_prescricao"
                    readonly="1"
                    nolabel="1"
                    colspan="2"
                    class="text-danger fw-bold"
                    invisible="not l10n_br_aviso_prescricao"
                />
            </xpath>
        </field>
    </record>
    <record id="hr_leave_allocation_view_form_vacation" model="ir.ui.view">
        <field name="name">hr.leave.allocation.form.vacation</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="l10n_br_periodo_perdido" />
            </xpath>
        </field>
    </record>
</odoo>
