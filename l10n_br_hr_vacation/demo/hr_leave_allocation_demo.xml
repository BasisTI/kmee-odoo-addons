    <record id="demo_allocation_joao" model="hr.leave.allocation">
        <field name="name">Férias 2024 - João Carlos da Silva</field>
        <field name="holiday_status_id" ref="leave_type_ferias" />
        <field name="employee_id" ref="l10n_br_hr.demo_employee_joao" />
        <field name="number_of_days">30</field>
        <field name="l10n_br_faltas_periodo_aquisitivo">0</field>
        <field name="state">confirm</field>
    </record>

