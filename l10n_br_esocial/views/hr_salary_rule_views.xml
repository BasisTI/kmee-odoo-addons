<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_salary_rule_form_esocial" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.esocial</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="payroll.hr_salary_rule_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="eSocial" name="esocial">
                    <field name="l10n_br_esocial_cod_inc_irrf_expirado" invisible="1" />
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not l10n_br_esocial_cod_inc_irrf_expirado"
                    >
                        Esta regra guarda uma incidência de IRRF que expirou na Tabela 21
                        do eSocial e não consta mais da lista. O S-1010 não é gerado
                        enquanto ela não for trocada pela incidência vigente (para o que
                        não é rendimento, retenção ou dedução de IRRF, a 09).
                    </div>
                    <group>
                        <group string="Identificação">
                            <field name="l10n_br_esocial_cod_rubr" />
                            <field name="l10n_br_esocial_ide_tab_rubr" />
                            <field name="l10n_br_esocial_nat_rubr_id" />
                            <field name="l10n_br_esocial_tp_rubr" />
                        </group>
                        <group string="Incidências Tributárias">
                            <field name="l10n_br_esocial_cod_inc_cp" />
                            <field name="l10n_br_esocial_cod_inc_irrf" />
                            <field name="l10n_br_esocial_cod_inc_fgts" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
