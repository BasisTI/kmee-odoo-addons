<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_payslip_form_esocial" model="ir.ui.view">
        <field name="name">hr.payslip.form.esocial</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_esocial_gerar_s1200"
                    type="object"
                    string="Gerar S-1200 eSocial"
                    invisible="state != 'done'"
                />
                <button
                    name="action_esocial_gerar_s1210"
                    type="object"
                    string="Gerar S-1210 eSocial"
                    invisible="state != 'done' or not l10n_br_esocial_s1200_id"
                />
                <button
                    name="action_esocial_gerar_s2299"
                    type="object"
                    string="Gerar S-2299 eSocial (rescisão)"
                    invisible="state != 'done'"
                />
            </xpath>
            <xpath expr="//header" position="after">
                <field name="l10n_br_esocial_a_retificar" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not l10n_br_esocial_a_retificar"
                >
                    Holerite fora de vigor (estornado) com S-1200/S-1210 já
                    gerado: o evento declara valores que a folha desfez. Gere o
                    S-1200/S-1210 do holerite que o substitui (retificação) ou
                    exclua o evento por S-3000.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="eSocial" name="esocial">
                    <group>
                        <group string="Eventos">
                            <field name="l10n_br_esocial_s1200_id" />
                            <field name="l10n_br_esocial_s1210_id" />
                            <field name="l10n_br_esocial_a_retificar" />
                        </group>
                        <group string="Pagamento (regime de caixa)">
                            <field name="l10n_br_esocial_data_pagamento" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
