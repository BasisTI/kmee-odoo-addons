<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Regras salariais para benefícios brasileiros.

        Usa current_contract.advantages.CÓDIGO do OCA payroll_contract_advantages.
        Os valores são configurados por contrato via advantage templates.

        Convenções:
          - DESC_VT: desconto limitado a 6% (DED)
          - DESC_PLANO_SAUDE: desconto dedutível do IRRF (DED)
          - VR_INFO, VA_INFO: informativos, não tributáveis (INFO)
    -->

    <!-- ══════════════════════════════════════════════════════════════
         DESCONTO VALE-TRANSPORTE (DED)
         Até 6% do salário-base (percentual da CCT, se houver), limitado ao
         crédito do VT (valor diário x dias úteis)
         ══════════════════════════════════════════════════════════════ -->
    <record id="hr_rule_desc_vt" model="hr.salary.rule">
        <field name="name">Desconto Vale-Transporte</field>
        <field name="sequence" eval="52" />
        <field name="code">DESC_VT</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_ded"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = tools.br.credito_vt(contract) > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Percentual do salário-base do mês (sem variáveis): o da CCT vigente na
# competência, no máximo 6% (Lei 7.418/85, art. 4º); 6% sem CCT. Limitado ao
# custo do VT.
salario_base = tools.br.round_money(
    contract.wage * tools.br.dias_salario(contract) / 30
)
cct = tools.br.cct(contract)
pct_cct = cct.vt_employee_pct if cct else 0.0
result = tools.br.desconto_vt(salario_base, tools.br.credito_vt(contract), pct_cct)
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         DESCONTO VA/VR (DED) — rubrica 071
         (VR + VA do contrato) x taxa da faixa do salário na CCT vigente
         ══════════════════════════════════════════════════════════════ -->
    <record id="hr_rule_desc_vavr" model="hr.salary.rule">
        <field name="name">Desconto VA/VR (071)</field>
        <field name="sequence" eval="54" />
        <field name="code">DESC_VAVR</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_ded"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
# Contrato dispensado: sem desconto (0,00), sem cair para a CCT. Senão, só com
# CCT que defina faixas de VA/VR; sem CCT ou sem faixa, não há desconto.
cct = tools.br.cct(contract)
base = (current_contract.advantages.VR or 0) + (current_contract.advantages.VA or 0)
result = (
    not contract.l10n_br_vavr_dispensado
    and bool(cct)
    and base > 0
    and cct.vavr_rate(contract.wage) is not None
)
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Taxa da faixa do salário-base vigente (a faixa "acima de" cobre o resto).
cct = tools.br.cct(contract)
base = (current_contract.advantages.VR or 0) + (current_contract.advantages.VA or 0)
result = tools.br.round_money(base * cct.vavr_rate(contract.wage))
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         VALE-TRANSPORTE (INFO)
         Crédito do mês: valor diário da tarifa x dias úteis da escala,
         sem feriados, afastamentos e férias
         ══════════════════════════════════════════════════════════════ -->
    <record id="hr_rule_vt_info" model="hr.salary.rule">
        <field name="name">Vale-Transporte</field>
        <field name="sequence" eval="24" />
        <field name="code">VT_INFO</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_info"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = tools.br.credito_vt(contract) > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = tools.br.credito_vt(contract)
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         DESCONTO PLANO DE SAÚDE (DED)
         Coparticipação do empregado — dedutível do IRRF
         ══════════════════════════════════════════════════════════════ -->
    <record id="hr_rule_desc_plano_saude" model="hr.salary.rule">
        <field name="name">Desconto Plano de Saúde</field>
        <field name="sequence" eval="53" />
        <field name="code">DESC_PLANO_SAUDE</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_ded"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
ps = current_contract.advantages.PLANO_SAUDE
result = ps and ps > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = current_contract.advantages.PLANO_SAUDE
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         VALE-REFEIÇÃO (INFO — não tributável)
         ══════════════════════════════════════════════════════════════ -->
    <record id="hr_rule_vr_info" model="hr.salary.rule">
        <field name="name">Vale-Refeição</field>
        <field name="sequence" eval="25" />
        <field name="code">VR_INFO</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_info"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
vr = current_contract.advantages.VR
result = vr and vr > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = current_contract.advantages.VR
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         VALE-ALIMENTAÇÃO (INFO — não tributável)
         ══════════════════════════════════════════════════════════════ -->
    <record id="hr_rule_va_info" model="hr.salary.rule">
        <field name="name">Vale-Alimentação</field>
        <field name="sequence" eval="26" />
        <field name="code">VA_INFO</field>
        <field
            name="category_id"
            ref="l10n_br_hr_payroll.hr_salary_rule_category_info"
        />
        <field name="condition_select">python</field>
        <field name="condition_python">
va = current_contract.advantages.VA
result = va and va > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = current_contract.advantages.VA
        </field>
    </record>
</odoo>
