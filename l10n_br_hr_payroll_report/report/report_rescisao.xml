<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        TRCT e termo de quitação no leiaute do anexo da Portaria MTE 1.621/2010
        (revogada pela Portaria MTP 671/2021, que não trouxe outro modelo).
        Os dados vêm de ``report.l10n_br_hr_payroll_report.report_termo_rescisao``:
        o mapeamento rubrica -> campo numerado fica em Python, onde tem teste.
    -->
    <template id="report_termo_rescisao">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="t" t-value="trct[o.id]" />
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .rescisao-table { width: 100%; border-collapse: collapse; font-size: 9px; }
                            .rescisao-table td, .rescisao-table th { border: 1px solid #333; padding: 1px 3px; }
                            .rescisao-header { background-color: #e9e9e9; font-weight: bold; }
                            .rescisao-title { font-size: 12px; font-weight: bold; text-align: center; padding: 4px; }
                            .rescisao-campo { width: 4%; text-align: center; color: #555; }
                            .text-right { text-align: right; }
                            .text-center { text-align: center; }
                            .rescisao-totals td { font-weight: bold; background-color: #f5f5f5; }
                        </style>

                        <table class="rescisao-table">
                            <tr>
                                <td colspan="6" class="rescisao-title">
                                    TERMO DE RESCISÃO DO CONTRATO DE TRABALHO
                                </td>
                            </tr>
                        </table>

                        <!-- IDENTIFICAÇÃO DO EMPREGADOR -->
                        <table class="rescisao-table">
                            <tr class="rescisao-header">
                                <td colspan="6">IDENTIFICAÇÃO DO EMPREGADOR</td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>01 CNPJ/CEI:</strong>
                                    <span t-esc="t['empregador']['cnpj']" />
                                </td>
                                <td colspan="4">
                                    <strong>02 Razão Social/Nome:</strong>
                                    <span t-esc="t['empregador']['razao_social']" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">
                                    <strong>03 Endereço:</strong>
                                    <span t-esc="t['empregador']['logradouro']" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>04 Bairro:</strong>
                                    <span t-esc="t['empregador']['bairro']" />
                                </td>
                                <td colspan="2">
                                    <strong>08 CNAE:</strong>
                                    <span t-esc="t['empregador']['cnae']" />
                                </td>
                                <td colspan="2">
                                    <strong>09 CNPJ/CEI Tomador/Obra:</strong>
                                    <span t-esc="t['empregador']['tomador']" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3">
                                    <strong>05 Município:</strong>
                                    <span t-esc="t['empregador']['municipio']" />
                                </td>
                                <td>
                                    <strong>06 UF:</strong>
                                    <span t-esc="t['empregador']['uf']" />
                                </td>
                                <td colspan="2">
                                    <strong>07 CEP:</strong>
                                    <span t-esc="t['empregador']['cep']" />
                                </td>
                            </tr>
                        </table>

                        <!-- IDENTIFICAÇÃO DO TRABALHADOR -->
                        <table class="rescisao-table">
                            <tr class="rescisao-header">
                                <td colspan="6">IDENTIFICAÇÃO DO TRABALHADOR</td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>10 PIS/PASEP:</strong>
                                    <span t-esc="t['trabalhador']['pis']" />
                                </td>
                                <td colspan="4">
                                    <strong>11 Nome:</strong>
                                    <span t-esc="t['trabalhador']['nome']" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">
                                    <strong>12 Endereço:</strong>
                                    <span t-esc="t['trabalhador']['logradouro']" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">
                                    <strong>13 Bairro:</strong>
                                    <span t-esc="t['trabalhador']['bairro']" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3">
                                    <strong>14 Município:</strong>
                                    <span t-esc="t['trabalhador']['municipio']" />
                                </td>
                                <td>
                                    <strong>15 UF:</strong>
                                    <span t-esc="t['trabalhador']['uf']" />
                                </td>
                                <td colspan="2">
                                    <strong>16 CEP:</strong>
                                    <span t-esc="t['trabalhador']['cep']" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3">
                                    <strong
                                    >17 Carteira de Trabalho (nº, série, UF):</strong>
                                    <span t-esc="t['trabalhador']['ctps']" />
                                    <t t-if="t['trabalhador']['ctps_serie']"> / <span
                                        t-esc="t['trabalhador']['ctps_serie']"
                                    /></t>
                                </td>
                                <td>
                                    <strong>18 CPF:</strong>
                                    <span t-esc="t['trabalhador']['cpf']" />
                                </td>
                                <td colspan="2">
                                    <strong>19 Data de nascimento:</strong>
                                    <span
                                        t-if="t['trabalhador']['nascimento']"
                                        t-esc="t['trabalhador']['nascimento']"
                                        t-options='{"widget": "date"}'
                                    />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">
                                    <strong>20 Nome da mãe:</strong>
                                    <span t-esc="t['trabalhador']['mae']" />
                                </td>
                            </tr>
                        </table>

                        <!-- DADOS DO CONTRATO -->
                        <table class="rescisao-table">
                            <tr class="rescisao-header">
                                <td colspan="6">DADOS DO CONTRATO</td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>21 Tipo de contrato:</strong>
                                    <span t-esc="t['contrato']['tipo_contrato']" />
                                </td>
                                <td colspan="2">
                                    <strong>22 Causa do afastamento:</strong>
                                    <span t-esc="t['contrato']['causa']" />
                                </td>
                                <td colspan="2">
                                    <strong>23 Remuneração mês anterior:</strong>
                                    <span
                                        t-esc="t['contrato']['remuneracao']"
                                        t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                    />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>24 Data de admissão:</strong>
                                    <span
                                        t-if="t['contrato']['admissao']"
                                        t-esc="t['contrato']['admissao']"
                                        t-options='{"widget": "date"}'
                                    />
                                </td>
                                <td colspan="2">
                                    <strong>25 Data do aviso prévio:</strong>
                                    <span
                                        t-if="t['contrato']['aviso']"
                                        t-esc="t['contrato']['aviso']"
                                        t-options='{"widget": "date"}'
                                    />
                                </td>
                                <td colspan="2">
                                    <strong>26 Data de afastamento:</strong>
                                    <span
                                        t-if="t['contrato']['afastamento']"
                                        t-esc="t['contrato']['afastamento']"
                                        t-options='{"widget": "date"}'
                                    />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong
                                    >27 Cód. afastamento (mtvDeslig eSocial):</strong>
                                    <span t-esc="t['contrato']['codigo_afastamento']" />
                                </td>
                                <td>
                                    <strong>28 Pensão alim. (%) TRCT:</strong>
                                    <span
                                        t-esc="'%.2f' % t['contrato']['pensao_trct']"
                                    />
                                </td>
                                <td>
                                    <strong>29 Pensão alim. (%) FGTS:</strong>
                                    <span
                                        t-if="t['contrato']['pensao_fgts']"
                                        t-esc="'%.2f' % t['contrato']['pensao_fgts']"
                                    />
                                </td>
                                <td colspan="2">
                                    <strong>30 Categoria do trabalhador:</strong>
                                    <span t-esc="t['contrato']['categoria']" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>31 Código sindical:</strong>
                                </td>
                                <td colspan="4">
                                    <strong
                                    >32 CNPJ e nome da entidade sindical laboral:</strong>
                                    <span t-esc="t['contrato']['sindicato']" />
                                </td>
                            </tr>
                        </table>

                        <!-- DISCRIMINAÇÃO DAS VERBAS RESCISÓRIAS -->
                        <t t-set="metade" t-value="(len(t['verbas']) + 1) // 2" />
                        <table class="rescisao-table">
                            <tr class="rescisao-header">
                                <td
                                    colspan="6"
                                >DISCRIMINAÇÃO DAS VERBAS RESCISÓRIAS</td>
                            </tr>
                            <t t-foreach="range(metade)" t-as="i">
                                <t t-set="esq" t-value="t['verbas'][i]" />
                                <t
                                    t-set="dir"
                                    t-value="t['verbas'][i + metade] if i + metade &lt; len(t['verbas']) else False"
                                />
                                <tr class="rescisao-verba">
                                    <td class="rescisao-campo">
                                        <span t-esc="esq[0]" />
                                    </td>
                                    <td style="width:34%;">
                                        <span t-esc="esq[1]" />
                                        <t t-if="esq[3]"> (<span t-esc="esq[3]" />)</t>
                                    </td>
                                    <td class="text-right" style="width:12%;">
                                        <t t-if="esq[2]">
                                            <span
                                                t-esc="esq[2]"
                                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                            />
                                        </t>
                                    </td>
                                    <t t-if="dir">
                                        <td class="rescisao-campo">
                                            <span t-esc="dir[0]" />
                                        </td>
                                        <td style="width:34%;">
                                            <span t-esc="dir[1]" />
                                            <t t-if="dir[3]"> (<span
                                                t-esc="dir[3]"
                                            />)</t>
                                        </td>
                                        <td class="text-right" style="width:12%;">
                                            <t t-if="dir[2]">
                                                <span
                                                    t-esc="dir[2]"
                                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                />
                                            </t>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="3" />
                                    </t>
                                </tr>
                            </t>
                            <t t-if="t['outras_verbas']">
                                <tr class="rescisao-header">
                                    <td colspan="6">95 Outras Verbas: detalhamento</td>
                                </tr>
                                <t t-foreach="t['outras_verbas']" t-as="ov">
                                    <tr class="rescisao-outras">
                                        <td colspan="5">
                                            <span t-esc="ov[0]" />
                                            <span t-esc="ov[1]" />
                                        </td>
                                        <td class="text-right">
                                            <span
                                                t-esc="ov[2]"
                                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </table>

                        <!-- DEDUÇÕES -->
                        <t t-set="metade_d" t-value="(len(t['descontos']) + 1) // 2" />
                        <table class="rescisao-table">
                            <tr class="rescisao-header">
                                <td colspan="6">DEDUÇÕES</td>
                            </tr>
                            <t t-foreach="range(metade_d)" t-as="i">
                                <t t-set="esq" t-value="t['descontos'][i]" />
                                <t
                                    t-set="dir"
                                    t-value="t['descontos'][i + metade_d] if i + metade_d &lt; len(t['descontos']) else False"
                                />
                                <tr class="rescisao-deducao">
                                    <td class="rescisao-campo">
                                        <span t-esc="esq[0]" />
                                    </td>
                                    <td style="width:34%;">
                                        <span t-esc="esq[1]" />
                                    </td>
                                    <td class="text-right" style="width:12%;">
                                        <t t-if="esq[2]">
                                            <span
                                                t-esc="esq[2]"
                                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                            />
                                        </t>
                                    </td>
                                    <t t-if="dir">
                                        <td class="rescisao-campo">
                                            <span t-esc="dir[0]" />
                                        </td>
                                        <td style="width:34%;">
                                            <span t-esc="dir[1]" />
                                        </td>
                                        <td class="text-right" style="width:12%;">
                                            <t t-if="dir[2]">
                                                <span
                                                    t-esc="dir[2]"
                                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                                />
                                            </t>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="3" />
                                    </t>
                                </tr>
                            </t>
                            <t t-if="t['outros_descontos']">
                                <tr class="rescisao-header">
                                    <td
                                        colspan="6"
                                    >115 Outros Descontos: detalhamento</td>
                                </tr>
                                <t t-foreach="t['outros_descontos']" t-as="od">
                                    <tr class="rescisao-outros">
                                        <td colspan="5">
                                            <span t-esc="od[0]" />
                                            <span t-esc="od[1]" />
                                        </td>
                                        <td class="text-right">
                                            <span
                                                t-esc="od[2]"
                                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </table>

                        <!-- TOTAIS E LÍQUIDO -->
                        <table class="rescisao-table">
                            <tr class="rescisao-totals">
                                <td class="text-center" style="width:40%;">TOTAIS</td>
                                <td class="text-right">Total bruto: <span
                                    t-esc="t['total_bruto']"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                /></td>
                                <td class="text-right">Total das deduções: <span
                                    t-esc="t['total_deducoes']"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                /></td>
                                <td class="text-right">Valor rescisório líquido: <span
                                    t-esc="t['liquido']"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                /></td>
                            </tr>
                        </table>

                        <!-- Multa do FGTS e demais informativos: não integram os
                             totais nem o líquido (TG-92). -->
                        <t t-foreach="t['informativos']" t-as="inf">
                            <p
                                class="multa-fgts-informativa"
                                style="font-size: 8px; margin: 2px 0;"
                            >
                                <span t-esc="inf.name" />
                                (informativa, não integra verbas, deduções nem o líquido):
                                <strong>
                                <span
                                    t-esc="inf.total"
                                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                                />
                            </strong>
                            </p>
                        </t>

                        <p style="font-size: 8px; margin: 4px 0;">
                            A falta de aviso prévio por parte do empregado dá ao empregador o direito
                            de descontar os salários correspondentes ao prazo respectivo
                            (art. 487, §2º, CLT). Local e data: ____________________________________
                        </p>

                        <table style="width:100%; font-size: 9px;">
                            <tr>
                                <td
                                    style="width:50%; text-align:center; padding-top:22px; border-top:1px solid #333;"
                                >
                                    Assinatura do Empregador ou Preposto
                                </td>
                                <td
                                    style="width:50%; text-align:center; padding-top:22px; border-top:1px solid #333;"
                                >
                                    Assinatura do Trabalhador
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- TERMO DE QUITAÇÃO -->
                    <div class="page termo-quitacao" style="page-break-before: always;">
                        <table class="rescisao-table">
                            <tr>
                                <td class="rescisao-title">
                                    TERMO DE QUITAÇÃO DE RESCISÃO DO CONTRATO DE TRABALHO
                                </td>
                            </tr>
                        </table>
                        <p
                            style="font-size: 11px; text-align: justify; margin-top: 12px;"
                        >
                            Empregador: <strong
                            t-esc="t['empregador']['razao_social']"
                        />,
                            CNPJ/CEI <span t-esc="t['empregador']['cnpj']" />.
                            Trabalhador: <strong t-esc="t['trabalhador']['nome']" />,
                            CPF <span t-esc="t['trabalhador']['cpf']" />,
                            admitido em
                            <span
                            t-if="t['contrato']['admissao']"
                            t-esc="t['contrato']['admissao']"
                            t-options='{"widget": "date"}'
                        />,
                            afastado em
                            <span
                            t-if="t['contrato']['afastamento']"
                            t-esc="t['contrato']['afastamento']"
                            t-options='{"widget": "date"}'
                        />
                            (<span t-esc="t['contrato']['causa']" />).
                        </p>
                        <p style="font-size: 11px; text-align: justify;">
                            Foi realizada a rescisão do contrato de trabalho acima
                            identificado. O trabalhador recebeu, em
                            ____/____/________, a importância líquida de
                            <strong>
                            <span
                                t-esc="t['liquido']"
                                t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                            />
                        </strong>, correspondente às
                            verbas discriminadas no Termo de Rescisão do Contrato de
                            Trabalho (TRCT), e dá ao empregador a quitação das parcelas
                            nele consignadas, ressalvados os direitos e valores não
                            discriminados no termo.
                        </p>
                        <p style="font-size: 11px;">
                            Ressalvas: ____________________________________________
                            ____________________________________________________________
                        </p>
                        <br />
                        <table style="width:100%; font-size: 10px;">
                            <tr>
                                <td
                                    style="width:50%; text-align:center; padding-top:30px; border-top:1px solid #333;"
                                >
                                    Assinatura do Empregador ou Preposto
                                </td>
                                <td
                                    style="width:50%; text-align:center; padding-top:30px; border-top:1px solid #333;"
                                >
                                    Assinatura do Trabalhador
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
