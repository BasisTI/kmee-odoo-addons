<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_recibo_ferias">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="c" t-value="contracheque[o.id]" />
                    <t t-set="f" t-value="ferias[o.id]" />
                    <t
                        t-set="moeda"
                        t-value='{"widget": "monetary", "display_currency": o.company_id.currency_id}'
                    />
                    <div class="page">
                        <style>
                            .ferias-table { width: 100%; border-collapse: collapse; font-size: 10px; }
                            .ferias-table td, .ferias-table th { border: 1px solid #333; padding: 2px 4px; }
                            .ferias-header { background-color: #e9e9e9; font-weight: bold; }
                            .ferias-title { font-size: 12px; font-weight: bold; text-align: center; padding: 4px; }
                            .text-right { text-align: right; }
                            .text-center { text-align: center; }
                            .ferias-totals td { font-weight: bold; background-color: #f5f5f5; }
                        </style>

                        <!-- CABEÇALHO -->
                        <table class="ferias-table">
                            <tr>
                                <td colspan="4" class="ferias-title">
                                    RECIBO DE FÉRIAS
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3">
                                    <strong>Empresa:</strong>
                                    <span t-field="o.company_id.name" />
                                </td>
                                <td>
                                    <strong>CNPJ:</strong>
                                    <span t-field="o.company_id.vat" />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- DADOS DO EMPREGADO -->
                        <table class="ferias-table">
                            <tr class="ferias-header">
                                <td colspan="4">DADOS DO EMPREGADO</td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Nome:</strong>
                                    <span t-field="o.employee_id.name" />
                                </td>
                                <td>
                                    <strong>CPF:</strong>
                                    <span t-field="o.employee_id.cnpj_cpf" />
                                </td>
                                <td>
                                    <strong>CTPS:</strong>
                                    <span t-field="o.employee_id.ctps" />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Cargo:</strong>
                                    <span t-field="o.employee_id.job_id" />
                                </td>
                                <td>
                                    <strong>Depto:</strong>
                                    <span t-field="o.employee_id.department_id" />
                                </td>
                                <td>
                                    <strong>Admissão:</strong>
                                    <span t-field="o.contract_id.date_start" />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- PERÍODO DE FÉRIAS -->
                        <table class="ferias-table">
                            <tr class="ferias-header">
                                <td colspan="4">PERÍODOS</td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Período aquisitivo:</strong>
                                    <t t-if="f['aquisitivo_inicio']">
                                        <span
                                        t-esc="f['aquisitivo_inicio']"
                                        t-options='{"widget": "date"}'
                                    /> a
                                        <span
                                        t-esc="f['aquisitivo_fim']"
                                        t-options='{"widget": "date"}'
                                    />
                                    </t>
                                    <t t-else="">não informado</t>
                                </td>
                                <td colspan="2">
                                    <strong>Dias de direito:</strong>
                                    <t t-if="f['dias_direito']">
                                        <t t-esc="int(f['dias_direito'])" />
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Período de gozo:</strong>
                                    <span
                                    t-esc="f['gozo_inicio']"
                                    t-options='{"widget": "date"}'
                                /> a
                                    <span
                                    t-esc="f['gozo_fim']"
                                    t-options='{"widget": "date"}'
                                />
                                    (<t t-esc="f['dias_gozados']" /> dias<t
                                    t-if="f['fracoes'] &gt; 1"
                                >, período <t t-esc="f['fracao']" /> de <t
                                    t-esc="f['fracoes']"
                                /></t>)
                                </td>
                                <td>
                                    <strong>Retorno ao trabalho:</strong>
                                    <span
                                        t-esc="f['retorno']"
                                        t-options='{"widget": "date"}'
                                    />
                                </td>
                                <td>
                                    <strong>Pagar até:</strong>
                                    <span
                                        t-esc="f['pagar_ate']"
                                        t-options='{"widget": "date"}'
                                    />
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Abono pecuniário:</strong>
                                    <t t-if="f['dias_abono']">
                                        <t t-esc="f['dias_abono']" /> dias vendidos
                                    </t>
                                    <t t-else="">não há venda de dias</t>
                                </td>
                                <td colspan="2">
                                    <strong>Salário base:</strong>
                                    <span t-esc="f['salario']" t-options="moeda" />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- REMUNERAÇÃO DAS FÉRIAS -->
                        <table class="ferias-table">
                            <tr class="ferias-header">
                                <td colspan="4">REMUNERAÇÃO DE REFERÊNCIA (30 DIAS)</td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Salário:</strong>
                                    <span t-esc="f['salario']" t-options="moeda" />
                                </td>
                                <td>
                                    <strong>Média das variáveis:</strong>
                                    <span t-esc="f['media']" t-options="moeda" />
                                </td>
                                <td>
                                    <strong>Adicionais fixos:</strong>
                                    <span t-esc="f['adicionais']" t-options="moeda" />
                                </td>
                                <td>
                                    <strong>Total:</strong>
                                    <span t-esc="f['remuneracao']" t-options="moeda" />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- PROVENTOS E DESCONTOS -->
                        <table class="ferias-table">
                            <tr class="ferias-header">
                                <td style="width:8%;" class="text-center">Cód</td>
                                <td style="width:42%;">Descrição</td>
                                <td style="width:25%;" class="text-right">Proventos</td>
                                <td style="width:25%;" class="text-right">Descontos</td>
                            </tr>
                            <t t-foreach="c['proventos']" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-field="line.code" />
                                    </td>
                                    <td>
                                        <span t-field="line.name" />
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line.total" t-options="moeda" />
                                    </td>
                                    <td />
                                </tr>
                            </t>
                            <t t-foreach="c['descontos']" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-field="line.code" />
                                    </td>
                                    <td>
                                        <span t-field="line.name" />
                                    </td>
                                    <td />
                                    <td class="text-right">
                                        <span t-esc="line.total" t-options="moeda" />
                                    </td>
                                </tr>
                            </t>
                            <tr class="ferias-totals">
                                <td colspan="2" class="text-center">TOTAIS</td>
                                <td class="text-right">
                                    <span
                                        t-esc="c['total_proventos']"
                                        t-options="moeda"
                                    />
                                </td>
                                <td class="text-right">
                                    <span
                                        t-esc="c['total_descontos']"
                                        t-options="moeda"
                                    />
                                </td>
                            </tr>
                            <tr class="ferias-totals">
                                <td colspan="2" class="text-center">
                                    LÍQUIDO A RECEBER
                                </td>
                                <td colspan="2" class="text-right">
                                    <span t-esc="c['liquido']" t-options="moeda" />
                                </td>
                            </tr>
                        </table>

                        <!-- BASES -->
                        <t t-if="c['bases']">
                            <br />
                            <table class="ferias-table">
                                <tr class="ferias-header">
                                    <t t-foreach="c['bases']" t-as="base">
                                        <td class="text-center">
                                            <t t-esc="base[0]" />
                                        </td>
                                    </t>
                                </tr>
                                <tr>
                                    <t t-foreach="c['bases']" t-as="base">
                                        <td class="text-right">
                                            <span t-esc="base[1]" t-options="moeda" />
                                        </td>
                                    </t>
                                </tr>
                            </table>
                        </t>

                        <br />
                        <br />

                        <!-- DECLARAÇÃO -->
                        <p style="font-size: 10px;">
                            Declaro que recebi a importância líquida acima discriminada,
                            referente às férias do período de gozo indicado neste recibo,
                            dando plena e irrevogável quitação das verbas aqui discriminadas.
                        </p>

                        <br />
                        <br />

                        <!-- ASSINATURAS -->
                        <table style="width:100%;">
                            <tr>
                                <td
                                    style="width:50%; text-align:center; padding-top:30px; border-top:1px solid #333;"
                                >
                                    Empregador
                                </td>
                                <td
                                    style="width:50%; text-align:center; padding-top:30px; border-top:1px solid #333;"
                                >
                                    Empregado
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Aviso de férias (CLT art. 135) -->
    <template id="report_aviso_ferias">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="a" t-value="aviso[o.id]" />
                    <t t-set="f" t-value="a['ferias']" />
                    <div class="page">
                        <h3 class="text-center">AVISO DE FÉRIAS</h3>
                        <br />
                        <p>
                            <strong>Empresa:</strong>
                            <span t-field="o.company_id.name" /> —
                            <strong>CNPJ:</strong>
                            <span t-field="o.company_id.vat" />
                        </p>
                        <p>
                            <strong>Empregado:</strong>
                            <span t-field="o.employee_id.name" /> —
                            <strong>CPF:</strong>
                            <span t-field="o.employee_id.cnpj_cpf" />
                        </p>
                        <p>
                            <strong>Cargo:</strong>
                            <span t-field="o.employee_id.job_id" />
                        </p>
                        <br />
                        <p>
                            Comunicamos que suas férias serão concedidas no período de
                            <strong
                            t-esc="f['gozo_inicio']"
                            t-options='{"widget": "date"}'
                        />
                            a
                            <strong
                            t-esc="f['gozo_fim']"
                            t-options='{"widget": "date"}'
                        />
                            (<t t-esc="f['dias_gozados']" /> dias corridos), devendo
                            retornar ao trabalho em
                            <strong
                            t-esc="f['retorno']"
                            t-options='{"widget": "date"}'
                        />.
                        </p>
                        <p t-if="f['aquisitivo_inicio']">
                            Período aquisitivo:
                            <span
                            t-esc="f['aquisitivo_inicio']"
                            t-options='{"widget": "date"}'
                        />
                            a
                            <span
                            t-esc="f['aquisitivo_fim']"
                            t-options='{"widget": "date"}'
                        />.
                        </p>
                        <p t-if="f['fracoes'] &gt; 1">
                            Período <t t-esc="f['fracao']" /> de
                            <t t-esc="f['fracoes']" /> do fracionamento das férias.
                        </p>
                        <p t-if="f['dias_abono']">
                            Foi solicitada a conversão de
                            <t t-esc="f['dias_abono']" /> dias em abono pecuniário.
                        </p>
                        <p>
                            O pagamento será feito até
                            <strong
                            t-esc="f['pagar_ate']"
                            t-options='{"widget": "date"}'
                        />
                            (CLT, art. 145).
                        </p>
                        <p>
                            Este aviso é dado por escrito, com antecedência mínima de
                            <t
                            t-esc="a['dias_antecedencia_minima']"
                        /> dias (CLT, art. 135):
                            a data limite para a comunicação é
                            <strong
                            t-esc="a['data_minima']"
                            t-options='{"widget": "date"}'
                        />.
                        </p>
                        <p
                            t-if="a['fora_do_prazo']"
                            class="aviso-fora-do-prazo"
                            style="border: 2px solid #a00; padding: 4px; color: #a00;"
                        >
                            <strong>ATENÇÃO:</strong> emitido em
                            <span
                            t-esc="a['emissao']"
                            t-options='{"widget": "date"}'
                        />, com
                            <t
                            t-esc="max(a['antecedencia'], 0)"
                        /> dias de antecedência,
                            abaixo dos
                            <t t-esc="a['dias_antecedencia_minima']" /> dias exigidos.
                        </p>
                        <br />
                        <p>
                            Data:
                            <span t-esc="a['emissao']" t-options='{"widget": "date"}' />
                        </p>
                        <br />
                        <br />
                        <table style="width:100%;">
                            <tr>
                                <td
                                    style="width:50%; text-align:center; padding-top:30px; border-top:1px solid #333;"
                                >
                                    Empregador
                                </td>
                                <td
                                    style="width:50%; text-align:center; padding-top:30px; border-top:1px solid #333;"
                                >
                                    Ciente do empregado em ___/___/______
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
